pragma solidity ^0.8.13;
import {Test, console2} from "forge-std/Test.sol";
import {Gzip} from "../src/Gzip.sol";
import {GzipYul} from "../src/GzipYul.sol";

contract GzipRoundtripTest is Test {

    bytes constant GZ_binary = hex"";
    bytes constant GZ_dynamic = hex"1f8b08000000000002ff0bc94855282ccd4cce56482aca2fcf5348cbaf50c82acd2d2856c82f4b2d5228014ae72456552aa4e4a7eb85d0482d000c9c14af84000000";
    bytes constant GZ_empty = hex"1f8b08000000000000ff03000000000000000000";
    bytes constant GZ_fixed_16kb = hex"";
    bytes constant GZ_fixed_2kb = hex"";
    bytes constant GZ_fixed_4kb = hex"";
    bytes constant GZ_fixed_64kb = hex"";
    bytes constant GZ_hello = hex"1f8b08000000000000fff348cdc9c9d75108cf2fca49510400d0c34aec0d000000";
    bytes constant GZ_repeated = hex"1f8b08000000000000ff73741c05230d00008f3381d8f4010000";
    bytes constant GZ_stored_100b = hex"1f8b08000000000000ff0164009bff000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f60616263f532c95864000000";
    bytes constant GZ_stored_1024b = hex"";
    bytes constant GZ_stored_10b = hex"1f8b08000000000000ff010a00f5ff0001020304050607080946d76c450a000000";
    bytes constant GZ_stored_16kb = hex"";
    bytes constant GZ_stored_1byte = hex"1f8b08000000000000ff010100feff5a6757bc5901000000";
    bytes constant GZ_stored_256b = hex"";
    bytes constant GZ_stored_2kb = hex"";
    bytes constant GZ_stored_4kb = hex"";
    bytes constant GZ_stored_50b = hex"1f8b08000000000000ff013200cdff000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031ff790cb532000000";
    bytes constant GZ_text_level6 = hex"1f8b08000000000000ffedcacb0182301400b055de044cd305408b7f0bd5aa30bd5cd822e7249d73cced72b8c550cbf71963f9c5b53da657944faef1def8deaf4b1ccba98b24cbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbf29eff7ccf6636e4570000";
    bytes constant GZ_text_level9 = hex"1f8b08000000000002ffedcacb0182301400b055de044cd305408b7f0bd5aa30bd5cd822e7249d73cced72b8c550cbf71963f9c5b53da657944faef1def8deaf4b1ccba98b24cbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbb22ccbf29eff7ccf6636e4570000";

    function test_allFiles() external view {
        assertEq(GzipYul.decompress(GZ_binary), Gzip.decompress(GZ_binary), "binary");
        assertEq(GzipYul.decompress(GZ_dynamic), Gzip.decompress(GZ_dynamic), "dynamic");
        assertEq(GzipYul.decompress(GZ_empty), Gzip.decompress(GZ_empty), "empty");
        assertEq(GzipYul.decompress(GZ_fixed_16kb), Gzip.decompress(GZ_fixed_16kb), "fixed_16kb");
        assertEq(GzipYul.decompress(GZ_fixed_2kb), Gzip.decompress(GZ_fixed_2kb), "fixed_2kb");
        assertEq(GzipYul.decompress(GZ_fixed_4kb), Gzip.decompress(GZ_fixed_4kb), "fixed_4kb");
        assertEq(GzipYul.decompress(GZ_fixed_64kb), Gzip.decompress(GZ_fixed_64kb), "fixed_64kb");
        assertEq(GzipYul.decompress(GZ_hello), Gzip.decompress(GZ_hello), "hello");
        assertEq(GzipYul.decompress(GZ_repeated), Gzip.decompress(GZ_repeated), "repeated");
        assertEq(GzipYul.decompress(GZ_stored_100b), Gzip.decompress(GZ_stored_100b), "stored_100b");
        assertEq(GzipYul.decompress(GZ_stored_1024b), Gzip.decompress(GZ_stored_1024b), "stored_1024b");
        assertEq(GzipYul.decompress(GZ_stored_10b), Gzip.decompress(GZ_stored_10b), "stored_10b");
        assertEq(GzipYul.decompress(GZ_stored_16kb), Gzip.decompress(GZ_stored_16kb), "stored_16kb");
        assertEq(GzipYul.decompress(GZ_stored_1byte), Gzip.decompress(GZ_stored_1byte), "stored_1byte");
        assertEq(GzipYul.decompress(GZ_stored_256b), Gzip.decompress(GZ_stored_256b), "stored_256b");
        assertEq(GzipYul.decompress(GZ_stored_2kb), Gzip.decompress(GZ_stored_2kb), "stored_2kb");
        assertEq(GzipYul.decompress(GZ_stored_4kb), Gzip.decompress(GZ_stored_4kb), "stored_4kb");
        assertEq(GzipYul.decompress(GZ_stored_50b), Gzip.decompress(GZ_stored_50b), "stored_50b");
        assertEq(GzipYul.decompress(GZ_text_level6), Gzip.decompress(GZ_text_level6), "text_level6");
        assertEq(GzipYul.decompress(GZ_text_level9), Gzip.decompress(GZ_text_level9), "text_level9");
    }

    function test_gasComparison() external view {
        uint256 g0a = gasleft(); Gzip.decompress(GZ_binary); uint256 r_binary = g0a - gasleft();
        uint256 g0b = gasleft(); GzipYul.decompress(GZ_binary); uint256 y_binary = g0b - gasleft();
        console2.log(string.concat("binary ref:", vm.toString(r_binary), " yul:", vm.toString(y_binary)));
        uint256 g1a = gasleft(); Gzip.decompress(GZ_dynamic); uint256 r_dynamic = g1a - gasleft();
        uint256 g1b = gasleft(); GzipYul.decompress(GZ_dynamic); uint256 y_dynamic = g1b - gasleft();
        console2.log(string.concat("dynamic ref:", vm.toString(r_dynamic), " yul:", vm.toString(y_dynamic)));
        uint256 g2a = gasleft(); Gzip.decompress(GZ_empty); uint256 r_empty = g2a - gasleft();
        uint256 g2b = gasleft(); GzipYul.decompress(GZ_empty); uint256 y_empty = g2b - gasleft();
        console2.log(string.concat("empty ref:", vm.toString(r_empty), " yul:", vm.toString(y_empty)));
        uint256 g3a = gasleft(); Gzip.decompress(GZ_fixed_16kb); uint256 r_fixed_16kb = g3a - gasleft();
        uint256 g3b = gasleft(); GzipYul.decompress(GZ_fixed_16kb); uint256 y_fixed_16kb = g3b - gasleft();
        console2.log(string.concat("fixed_16kb ref:", vm.toString(r_fixed_16kb), " yul:", vm.toString(y_fixed_16kb)));
        uint256 g4a = gasleft(); Gzip.decompress(GZ_fixed_2kb); uint256 r_fixed_2kb = g4a - gasleft();
        uint256 g4b = gasleft(); GzipYul.decompress(GZ_fixed_2kb); uint256 y_fixed_2kb = g4b - gasleft();
        console2.log(string.concat("fixed_2kb ref:", vm.toString(r_fixed_2kb), " yul:", vm.toString(y_fixed_2kb)));
        uint256 g5a = gasleft(); Gzip.decompress(GZ_fixed_4kb); uint256 r_fixed_4kb = g5a - gasleft();
        uint256 g5b = gasleft(); GzipYul.decompress(GZ_fixed_4kb); uint256 y_fixed_4kb = g5b - gasleft();
        console2.log(string.concat("fixed_4kb ref:", vm.toString(r_fixed_4kb), " yul:", vm.toString(y_fixed_4kb)));
        uint256 g6a = gasleft(); Gzip.decompress(GZ_fixed_64kb); uint256 r_fixed_64kb = g6a - gasleft();
        uint256 g6b = gasleft(); GzipYul.decompress(GZ_fixed_64kb); uint256 y_fixed_64kb = g6b - gasleft();
        console2.log(string.concat("fixed_64kb ref:", vm.toString(r_fixed_64kb), " yul:", vm.toString(y_fixed_64kb)));
        uint256 g7a = gasleft(); Gzip.decompress(GZ_hello); uint256 r_hello = g7a - gasleft();
        uint256 g7b = gasleft(); GzipYul.decompress(GZ_hello); uint256 y_hello = g7b - gasleft();
        console2.log(string.concat("hello ref:", vm.toString(r_hello), " yul:", vm.toString(y_hello)));
        uint256 g8a = gasleft(); Gzip.decompress(GZ_repeated); uint256 r_repeated = g8a - gasleft();
        uint256 g8b = gasleft(); GzipYul.decompress(GZ_repeated); uint256 y_repeated = g8b - gasleft();
        console2.log(string.concat("repeated ref:", vm.toString(r_repeated), " yul:", vm.toString(y_repeated)));
        uint256 g9a = gasleft(); Gzip.decompress(GZ_stored_100b); uint256 r_stored_100b = g9a - gasleft();
        uint256 g9b = gasleft(); GzipYul.decompress(GZ_stored_100b); uint256 y_stored_100b = g9b - gasleft();
        console2.log(string.concat("stored_100b ref:", vm.toString(r_stored_100b), " yul:", vm.toString(y_stored_100b)));
        uint256 g10a = gasleft(); Gzip.decompress(GZ_stored_1024b); uint256 r_stored_1024b = g10a - gasleft();
        uint256 g10b = gasleft(); GzipYul.decompress(GZ_stored_1024b); uint256 y_stored_1024b = g10b - gasleft();
        console2.log(string.concat("stored_1024b ref:", vm.toString(r_stored_1024b), " yul:", vm.toString(y_stored_1024b)));
        uint256 g11a = gasleft(); Gzip.decompress(GZ_stored_10b); uint256 r_stored_10b = g11a - gasleft();
        uint256 g11b = gasleft(); GzipYul.decompress(GZ_stored_10b); uint256 y_stored_10b = g11b - gasleft();
        console2.log(string.concat("stored_10b ref:", vm.toString(r_stored_10b), " yul:", vm.toString(y_stored_10b)));
        uint256 g12a = gasleft(); Gzip.decompress(GZ_stored_16kb); uint256 r_stored_16kb = g12a - gasleft();
        uint256 g12b = gasleft(); GzipYul.decompress(GZ_stored_16kb); uint256 y_stored_16kb = g12b - gasleft();
        console2.log(string.concat("stored_16kb ref:", vm.toString(r_stored_16kb), " yul:", vm.toString(y_stored_16kb)));
        uint256 g13a = gasleft(); Gzip.decompress(GZ_stored_1byte); uint256 r_stored_1byte = g13a - gasleft();
        uint256 g13b = gasleft(); GzipYul.decompress(GZ_stored_1byte); uint256 y_stored_1byte = g13b - gasleft();
        console2.log(string.concat("stored_1byte ref:", vm.toString(r_stored_1byte), " yul:", vm.toString(y_stored_1byte)));
        uint256 g14a = gasleft(); Gzip.decompress(GZ_stored_256b); uint256 r_stored_256b = g14a - gasleft();
        uint256 g14b = gasleft(); GzipYul.decompress(GZ_stored_256b); uint256 y_stored_256b = g14b - gasleft();
        console2.log(string.concat("stored_256b ref:", vm.toString(r_stored_256b), " yul:", vm.toString(y_stored_256b)));
        uint256 g15a = gasleft(); Gzip.decompress(GZ_stored_2kb); uint256 r_stored_2kb = g15a - gasleft();
        uint256 g15b = gasleft(); GzipYul.decompress(GZ_stored_2kb); uint256 y_stored_2kb = g15b - gasleft();
        console2.log(string.concat("stored_2kb ref:", vm.toString(r_stored_2kb), " yul:", vm.toString(y_stored_2kb)));
        uint256 g16a = gasleft(); Gzip.decompress(GZ_stored_4kb); uint256 r_stored_4kb = g16a - gasleft();
        uint256 g16b = gasleft(); GzipYul.decompress(GZ_stored_4kb); uint256 y_stored_4kb = g16b - gasleft();
        console2.log(string.concat("stored_4kb ref:", vm.toString(r_stored_4kb), " yul:", vm.toString(y_stored_4kb)));
        uint256 g17a = gasleft(); Gzip.decompress(GZ_stored_50b); uint256 r_stored_50b = g17a - gasleft();
        uint256 g17b = gasleft(); GzipYul.decompress(GZ_stored_50b); uint256 y_stored_50b = g17b - gasleft();
        console2.log(string.concat("stored_50b ref:", vm.toString(r_stored_50b), " yul:", vm.toString(y_stored_50b)));
        uint256 g18a = gasleft(); Gzip.decompress(GZ_text_level6); uint256 r_text_level6 = g18a - gasleft();
        uint256 g18b = gasleft(); GzipYul.decompress(GZ_text_level6); uint256 y_text_level6 = g18b - gasleft();
        console2.log(string.concat("text_level6 ref:", vm.toString(r_text_level6), " yul:", vm.toString(y_text_level6)));
        uint256 g19a = gasleft(); Gzip.decompress(GZ_text_level9); uint256 r_text_level9 = g19a - gasleft();
        uint256 g19b = gasleft(); GzipYul.decompress(GZ_text_level9); uint256 y_text_level9 = g19b - gasleft();
        console2.log(string.concat("text_level9 ref:", vm.toString(r_text_level9), " yul:", vm.toString(y_text_level9)));
    }
}
