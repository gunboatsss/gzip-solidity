#!/usr/bin/env python3
"""Generate test .gz files for GzipYul roundtrip testing.

Covers all block types: stored (BTYPE=0), fixed Huffman (BTYPE=1),
dynamic Huffman (BTYPE=2), plus edge cases.
Output: testdata/*.gz
"""

import gzip, io, os, random, struct, zlib

os.makedirs("testdata", exist_ok=True)


def make_gzip(data, compresslevel=6, mtime=0):
    buf = io.BytesIO()
    with gzip.GzipFile(
        fileobj=buf, mode="wb", compresslevel=compresslevel, mtime=mtime
    ) as f:
        f.write(data)
    return buf.getvalue()


def make_stored_gzip(data):
    """Manually construct a stored-block (BTYPE=0) gzip."""
    hdr = struct.pack(
        "<BBBBBBBBBB", 0x1F, 0x8B, 0x08, 0x00, 0, 0, 0, 0, 0x00, 0xFF
    )
    plen = len(data) & 0xFFFF
    nlen = (~plen) & 0xFFFF
    compressed = bytes([0x01]) + struct.pack("<HH", plen, nlen) + data
    crc = zlib.crc32(data) & 0xFFFFFFFF
    isize = len(data) & 0xFFFFFFFF
    footer = struct.pack("<II", crc, isize)
    return hdr + compressed + footer


# ── Fixed Huffman ──────────────────────────────────────────────

with open("testdata/empty.gz", "wb") as f:
    f.write(make_gzip(b""))

with open("testdata/hello.gz", "wb") as f:
    f.write(make_gzip(b"Hello, World!"))

with open("testdata/dynamic.gz", "wb") as f:
    f.write(
        make_gzip(
            b"The quick brown fox jumps over the lazy dog." * 3,
            compresslevel=9,
        )
    )

with open("testdata/repeated.gz", "wb") as f:
    f.write(make_gzip(b"A" * 500))

# ── Stored blocks (various sizes) ──────────────────────────────

with open("testdata/stored_1byte.gz", "wb") as f:
    f.write(make_stored_gzip(b"Z"))

for size in [10, 50, 100, 256, 1024]:
    data = (bytes(range(256)) * (size // 256 + 1))[:size]
    with open(f"testdata/stored_{size}b.gz", "wb") as f:
        f.write(make_stored_gzip(data))

# ── Binary incompressible ──────────────────────────────────────

random.seed(42)
binary_data = bytes(random.randint(0, 255) for _ in range(200))
with open("testdata/binary.gz", "wb") as f:
    f.write(make_stored_gzip(binary_data))

# ── Report ─────────────────────────────────────────────────────

print("Generated test files:")
for name in sorted(os.listdir("testdata")):
    path = os.path.join("testdata", name)
    with open(path, "rb") as f:
        gz = f.read()
    compressed = gz[10:-8]
    btype = (compressed[0] >> 1) & 3
    btype_names = {0: "stored", 1: "fixed", 2: "dynamic"}
    print(
        f"  {name:25s} {os.path.getsize(path):6d} bytes  "
        f"BTYPE={btype} ({btype_names.get(btype, '?')})"
    )
